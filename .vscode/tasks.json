{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: gcc 编译运行",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-Wall", "-Wextra", "-std=c11",
                "${file}",
                "${workspaceFolder}/tfe_core.c",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
